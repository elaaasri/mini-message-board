<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Oldenburg&family=Rye&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/icons/letter-icon.png" />
    <script src="https://kit.fontawesome.com/96f630ca48.js" crossorigin="anonymous"></script>
    <script type="module" src="script.js" defer></script>
    <title>Mini-Message-Board</title>
</head>
<body>
    
    <div class="messages-page">
        <h1> <%= title %> </h1>
        <img src="/icons/letter-icon.png" alt="letter icon">
        <a href="/new">+ Add Message</a>
        
        <div class="message-list">  
            <% messages?.forEach(message => { %>

                <div class="message-card">
                    <span>User: <%= message?.user %></span>
                    <p><%= message?.text %></p>
                    <hr>
                    <div class="message-date">
                        <img src="/icons/clock-icon.png" alt="clock icon">
                        <span><%= message?.added.toLocaleString() %></span>
                    </div>
                    <div class="message-card-footer">
                            <a href="/<%= message?.user %>">open</a>
                            <div class="message-like">
                                <i class="fa-solid fa-heart"></i>
                                <span data-user="<%= message?.user %>" class="like"><%= message?.likes %></span>
                            </div>
                    </div>
                </div>
                
            <% }); %>
        </div>
    </div>
        
        
    </body>
</html>