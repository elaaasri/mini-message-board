<!DOCTYPE html>
<html lang="en">
    <%- include('./partials/head.ejs') %>
<body>
    
    <%- include('./partials/header.ejs') %>
    <div class="messages-page">
        <a href="/new">+ Add Message</a>

        <div class="message-list"> 
            <% messages?.forEach(msg => { %>

                <div class="message-card">
                    <p>User: <%= msg?.username %></p>
                    <p><%= msg?.message %></p>
                    <hr>
                    <div class="message-date">
                        <img src="/icons/clock-icon.png" alt="clock icon">
                        <span><%= msg?.added?.toLocaleString() %></span>
                    </div>
                    <div class="message-card-footer">
                        <a href="/<%= msg?.id %>">open</a>
                        <div class="message-like">
                            <i class="fa-solid fa-heart"></i>
                            <span data-id="<%= msg?.id %>" class="likes"><%= msg?.likes %></span>
                        </div>
                    </div>
                </div>
                
            <% }); %>
        </div>
    </div>
    <%- include('./partials/footer.ejs') %>
        
    </body>
</html>